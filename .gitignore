data/state/
data/logs/
config/local.*
*.local.json
*.local.toml
*.log

# Generated or game-day media
media/generated/
recordings/
replays/
captures/
brand-baseline/

# OBS and machine-specific files
.obs-studio/
obs-profiles/
obs-scenes/
*.lnk

# Credentials and secrets
.env
.env.*
!.env.example
*.key
*.pem

# Editors and operating systems
